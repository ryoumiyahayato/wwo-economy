extends SceneTree
const Network=preload("res://merchant/merchant_market_network.gd")
const Save=preload("res://merchant/merchant_save.gd")
const Runtime=preload("res://merchant/merchant_runtime.gd")
const Opening=preload("res://merchant/merchant_opening.gd")
func _initialize() -> void: call_deferred("run")
func run() -> void:
	var op: Dictionary={"site_id":"site:a","stock_place_id":"place:a","inventory":{"bread":10},"free_inventory":{"bread":7},"committed_inventory":{"bread":3}}
	var shipment: Dictionary={"id":"shipment:1","physical_quantity":2,"quantity":3,"stage":"TRAVELLING","place_id":"place:mid"}
	var order: Dictionary={"id":"order:1","from_place_id":"place:a","to_place_id":"place:b","good":"bread","pending":3,"transit":3,"shipments":[shipment]}
	var own: Dictionary={"operations":[op],"orders":[order],"sales_orders":[order]}
	var original: Dictionary=own.duplicate(true)
	var a: Dictionary=Network.project(own,{"place:a":"country:old"},{"place:a":"centre:old"})
	var b: Dictionary=Network.project(own,{"place:a":"country:new"},{"place:a":"centre:new"})
	assert(a.nodes.keys()==b.nodes.keys())
	assert(a.known_own_stock_by_good==b.known_own_stock_by_good)
	assert(a.cargo==b.cargo and a.edges==b.edges)
	assert(a.known_own_stock_by_good.bread==10 and a.known_contract_cargo_by_good.bread==2)
	assert(a.nodes.has("place:mid"))
	assert(a.cargo.size()==1 and a.edges.size()==1 and a.issues.is_empty())
	assert(not a.aggregate_warehouse_created)
	a.nodes["place:a"].known_own_stock_by_good.bread=99
	assert(own==original)
	own.orders[0].shipments[0].erase("physical_quantity")
	assert(Network.project(own).known_contract_cargo_by_good.is_empty())
	assert(not Network.project(own).issues.is_empty())
	assert(Network.project({"operations":[],"orders":null,"sales_orders":null}).edges.is_empty())
	var args: PackedStringArray=OS.get_cmdline_user_args()
	var raw: Dictionary=Save._read(args[0],5)
	assert(raw.get("error","").is_empty())
	var built: WorldBuildResult=FormalPersistence.new().restore_candidate(raw.core)
	assert(built.success,built.error)
	var before: Dictionary=built.persistence.snapshot()
	var person: String=built.world.player_state.player_id()
	var firm: Dictionary=LivelihoodAction.query_firm(built.world,person,Opening.FIRM)
	var network: Dictionary=Network.project(firm)
	assert(network.issues.is_empty(),str(network.issues))
	assert(before==built.persistence.snapshot(),"Projection changed authoritative world")
	var changed: Dictionary=Network.project(firm,{"place:paris":"country:changed"},{"place:paris":"centre:changed"})
	assert(network.known_own_stock_by_good==changed.known_own_stock_by_good and network.cargo==changed.cargo)
	assert(before==built.persistence.snapshot())
	var runtime: RefCounted=Runtime.new()
	var host_view: Dictionary=runtime._view(built)
	assert(host_view.has("market_network") and host_view.market_network==network)
	assert(Runtime._plain(host_view))
	assert(before==built.persistence.snapshot(),"Host view changed world")
	var output: Dictionary={"actual_host_view_connected":true,"status":"PASS","scope":"NODE_PROJECTION_NOT_PRICE_POLICY_OR_FULL_NETWORK_SIMULATION","original_minute":built.world.game_clock.total_minutes(),"known_nodes":network.nodes.keys(),"world_unchanged":true,"network":network}
	var f: FileAccess=FileAccess.open(args[1],FileAccess.WRITE);assert(f!=null);f.store_string(JSON.stringify(output,"\t"));f.close()
	print("QA_MARKET_NETWORK_PASS unique physical cargo, stable place identity, own-only scope, exact world unchanged")
	quit()
