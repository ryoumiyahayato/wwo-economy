{
  "schemaVersion": "wwo-sandbox/scenario/v1",
  "name": "移动任务 · 理想补给与路径",
  "domain": "military",
  "adapterId": "demo.military.v1",
  "seed": 42,
  "maxTicks": 30,
  "boundary": "movement",
  "dependencies": {
    "supply": "on-demand",
    "transport": "instant",
    "funding": "normal",
    "path": "direct",
    "resupply": "on-demand"
