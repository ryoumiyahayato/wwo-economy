  },
  "expectations": {
    "rules": [
      {
        "id": "arrival",
        "label": "10 ticks 内位置达到 10",
        "target": "metric",
        "key": "position",
        "operator": "eq",
        "value": 10,
        "byTick": 10
      },
      {
        "id": "personnel",
        "label": "人员守恒残差始终为 0",
        "target": "invariant",
        "key": "personnel",
        "operator": "eq",
        "value": 0,
        "byTick": "always"
      },
      {
        "id": "ammo",
        "label": "弹药守恒残差始终为 0",
        "target": "invariant",
        "key": "ammo",
        "operator": "eq",
        "value": 0,
        "byTick": "always"
      }
    ],
    "observation": "移动任务不要求获胜；交火结果由游戏模拟函数计算，不保证命中。"
  }
